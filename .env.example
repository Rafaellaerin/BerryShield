# Development defaults. Replace every secret before production.
BERRYSHIELD_ENV=development
BERRYSHIELD_SIGNING_SECRET=replace-with-at-least-32-random-bytes-please
BERRYSHIELD_SIGNING_KID=dev-v1
BERRYSHIELD_PREVIOUS_SIGNING_KEYS_JSON={}
# Keep this stable while rotating signing keys if IP-prefix binding is enabled.
BERRYSHIELD_BINDING_SECRET=replace-with-a-separate-32-byte-binding-secret
BERRYSHIELD_SITE_KEY=bs_dev_public
BERRYSHIELD_SITE_SECRET=bs_dev_secret_change_me
BERRYSHIELD_ALLOWED_HOSTS=localhost,127.0.0.1
BERRYSHIELD_BIND_IP_PREFIX=false
BERRYSHIELD_TRUSTED_PROXY_CIDRS=
BERRYSHIELD_REPUTATION_URL=http://reputation:8081
BERRYSHIELD_RISK_ENGINE_URL=http://risk-engine:8082

# Optional reputation providers
ABUSEIPDB_API_KEY=
IPQS_API_KEY=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
